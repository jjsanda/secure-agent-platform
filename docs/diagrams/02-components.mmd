flowchart LR
    subgraph worker["Agent Worker (Python)"]
        direction TB
        Core["Agent core<br/>plan → act → observe"]
        Graph["LangGraph variant<br/>(same ports)"]
        LLM["LLM port<br/>mock (default) · Claude"]
        Guard["Security guard<br/>allow-list · SSRF · path · schema · injection"]
