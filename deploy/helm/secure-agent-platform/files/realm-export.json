{
  "realm": "secure-agent",
  "displayName": "Secure Agent Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Cross-tenant platform operator (reserved; no demo user carries it)."
      },
      {
        "name": "tenant-admin",
        "description": "Administers a single tenant (Alice, Tenant A)."
      },
      {
        "name": "member",
        "description": "Ordinary tenant member (Alice and Bob)."
      }
    ]
  },

  "groups": [
    {
      "name": "tenant-a",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "realmRoles": ["tenant-admin", "member"]
    },
    {
      "name": "tenant-b",
      "attributes": { "tenant_id": ["22222222-2222-2222-2222-222222222222"] },
      "realmRoles": ["member"]
    }
  ],

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@tenant-a.example",
      "firstName": "Alice",
      "lastName": "Tenant A Admin",
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "realmRoles": ["tenant-admin", "member"],
      "groups": ["/tenant-a"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@tenant-b.example",
      "firstName": "Bob",
      "lastName": "Tenant B Member",
      "attributes": {
        "tenant_id": ["22222222-2222-2222-2222-222222222222"]
      },
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ],
      "realmRoles": ["member"],
      "groups": ["/tenant-b"]
    }
  ],

  "clients": [
    {
      "clientId": "sap-dashboard",
      "name": "SAP Dashboard (SPA)",
      "description": "React dashboard; public OIDC client, authorization code + PKCE S256.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "audience-sap-control-plane",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sap-control-plane",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ]
}
