# Frontend build/runtime configuration (browser-visible; localhost URLs).
# Copy to `.env` for local `npm run dev`. These are baked into the bundle at
# build time — the defaults match the default docker-compose profile, so an
# unconfigured build already targets the local stack.

VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_ISSUER=http://localhost:9000
VITE_OIDC_CLIENT_ID=sap-dashboard
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
