# secure-agent-platform — example configuration.
# Copy to `.env` (git-ignored). The DEFAULT profile runs with ZERO secrets:
# a deterministic mock LLM and a local mock-OIDC provider. No API keys required.

# ---- Compose profiles -------------------------------------------------------
# empty = default (postgres + control-plane + mock-oidc + agent-worker + frontend)
# "keycloak"      swaps the mock IdP for real Keycloak
# "observability" adds otel-collector + jaeger + prometheus + grafana
# Do NOT run keycloak + observability together on a ~2GB machine.
COMPOSE_PROFILES=

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=sap
POSTGRES_APP_USER=sap_app
POSTGRES_APP_PASSWORD=sap_app_dev_pw
POSTGRES_OWNER_USER=sap_owner
POSTGRES_OWNER_PASSWORD=sap_owner_dev_pw
# Runtime connection is ALWAYS the non-privileged, NOBYPASSRLS app role:
DATABASE_URL=postgres://sap_app:sap_app_dev_pw@postgres:5432/sap?sslmode=disable
# Migrations run as the schema owner (DDL). pgx5 scheme = golang-migrate driver:
MIGRATE_DATABASE_URL=pgx5://sap_owner:sap_owner_dev_pw@postgres:5432/sap?sslmode=disable
# BYPASSRLS role — used ONLY by the one-time dev seed, never the request path:
MIGRATOR_DATABASE_URL=postgres://sap_migrator:sap_migrator_dev_pw@postgres:5432/sap?sslmode=disable
SEED_DEMO=true

# ---- Auth / OIDC (provider-agnostic) ----------------------------------------
# ISSUER is the token `iss` (browser-facing); DISCOVERY is where the backend
# fetches metadata/JWKS. In Docker they differ (localhost vs the service name).
OIDC_ISSUER_URL=http://localhost:9000
OIDC_DISCOVERY_URL=http://mock-oidc:9000
OIDC_AUDIENCE=sap-control-plane
OIDC_CLIENT_ID=sap-dashboard

# ---- Control plane ----------------------------------------------------------
CONTROL_PLANE_HTTP_ADDR=:8080
CONTROL_PLANE_GRPC_ADDR=:9090
WORKER_GRPC_ADDR=agent-worker:50051
# PASETO v4.public keypair for scoped credentials (dev). Generate with `make keys`.
PASETO_PRIVATE_KEY=
PASETO_PUBLIC_KEY=
# SPA origin allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173

# ---- Agent worker -----------------------------------------------------------
WORKER_GRPC_LISTEN=:50051
TOOLPROXY_GRPC_ADDR=control-plane:9090
LLM_ENGINE=mock                 # mock | anthropic
LLM_MODEL=claude-sonnet-5       # claude-sonnet-5 | claude-haiku-4-5 | claude-opus-4-8
AGENT_VARIANT=custom            # custom | langgraph
ANTHROPIC_API_KEY=              # only when LLM_ENGINE=anthropic

# ---- Observability (no-op unless set) --------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=    # e.g. http://otel-collector:4317 under the observability profile
OTEL_SERVICE_NAMESPACE=sap

# ---- Frontend (browser-visible; localhost URLs) ----------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_ISSUER=http://localhost:9000
VITE_OIDC_CLIENT_ID=sap-dashboard
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
