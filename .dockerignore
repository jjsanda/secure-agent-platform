# The control-plane and agent-worker build contexts are the repo root, so keep
# heavy/irrelevant trees out of the build context.
.git
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
frontend/dist
frontend/.vite
control-plane/bin
docs/diagrams/rendered
**/*.log
.env
.env.*
!.env.example
